{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/durable-study-feedback-result.schema.json",
  "type": "object",
  "properties": {
    "revision": {
      "const": 1
    },
    "assessment": {
      "enum": [
        "CORRECT",
        "PARTIALLY_CORRECT",
        "NEEDS_WORK",
        "INSUFFICIENT_INFORMATION"
      ]
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]",
      "not": {
        "pattern": "[\\u0000\\uD800-\\uDFFF]"
      }
    },
    "example": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]",
      "not": {
        "pattern": "[\\u0000\\uD800-\\uDFFF]"
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]",
        "not": {
          "pattern": "[\\u0000\\uD800-\\uDFFF]"
        }
      }
    },
    "review_checklist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]",
        "not": {
          "pattern": "[\\u0000\\uD800-\\uDFFF]"
        }
      }
    },
    "code_execution": {
      "const": "NOT_RUN"
    }
  },
  "required": [
    "revision",
    "assessment",
    "explanation",
    "example",
    "assumptions",
    "review_checklist",
    "code_execution"
  ],
  "additionalProperties": false
}
