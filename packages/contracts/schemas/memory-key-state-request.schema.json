{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/memory-key-state-request.schema.json",
  "$comment": "Wire-shape validation only. Ownership, recent database reauthentication, server session/epoch, payload binding, single-use approval, expiry and transaction atomicity require server enforcement. Parse with strict integer-only JSON and cap canonical request bodies at 16384 bytes before accepting.",
  "type": "object",
  "properties": {
    "scope": {
      "enum": [
        "GLOBAL",
        "PROJECT"
      ]
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$(?![\\s\\S])"
    }
  },
  "required": [
    "scope",
    "project_id",
    "key"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "GLOBAL"
          }
        }
      },
      "then": {
        "properties": {
          "project_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
          }
        }
      }
    }
  ]
}
