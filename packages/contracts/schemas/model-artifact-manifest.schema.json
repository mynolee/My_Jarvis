{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/model-artifact-manifest.schema.json",
  "type": "object",
  "properties": {
    "complete": {
      "const": true
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "maxLength": 200
    },
    "upstream_repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "maxLength": 200
    },
    "upstream_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "upstream_license_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "conversion_license_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "licenses_reviewed": {
      "const": true
    },
    "runtime_lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "template_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "tokenizer_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "processor_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "complete",
    "revision",
    "repo",
    "upstream_repo",
    "upstream_revision",
    "upstream_license_sha256",
    "conversion_license_sha256",
    "licenses_reviewed",
    "runtime_lock_sha256",
    "prompt_sha256",
    "template_files",
    "tokenizer_files",
    "processor_files",
    "files"
  ],
  "additionalProperties": false
}
