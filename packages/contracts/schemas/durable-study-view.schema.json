{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/durable-study-view.schema.json",
  "$comment": "Closed wire shape. Integer-only canonical JSON, byte ceilings and cross-field identity, version and time relationships are additionally checked by the service and contract oracle.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "conversation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "lesson_run_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "conversation_content_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "lifecycle": {
      "enum": [
        "OPEN",
        "CLOSED_BY_OWNER"
      ]
    },
    "stage": {
      "enum": [
        "WAITING_ANSWERS",
        "FEEDBACK_PENDING",
        "CLOSED_BY_OWNER"
      ]
    },
    "lesson": {
      "type": "object",
      "properties": {
        "concepts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]",
            "not": {
              "pattern": "[\\u0000\\uD800-\\uDFFF]"
            }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]",
                "not": {
                  "pattern": "[\\u0000\\uD800-\\uDFFF]"
                }
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "concepts",
        "questions"
      ],
      "additionalProperties": false
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "input_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
          },
          "attempt_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
          },
          "question_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000,
            "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]",
            "not": {
              "pattern": "[\\u0000\\uD800-\\uDFFF]"
            }
          },
          "feedback": {
            "type": "null"
          }
        },
        "required": [
          "input_id",
          "attempt_id",
          "question_id",
          "text",
          "feedback"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 2
    },
    "feedback_availability": {
      "const": "UNAVAILABLE"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])"
    }
  },
  "required": [
    "id",
    "conversation_id",
    "project_id",
    "lesson_run_id",
    "version",
    "conversation_content_version",
    "lifecycle",
    "stage",
    "lesson",
    "attempts",
    "feedback_availability",
    "created_at",
    "updated_at",
    "checked_at"
  ],
  "additionalProperties": false
}
