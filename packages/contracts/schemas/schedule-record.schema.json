{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/schedule-record.schema.json",
  "$comment": "Synthetic wire shape only. Strict integer-only JSON, actual dates, exact server timezone membership, sibling consistency, authority, DB clock, storage privacy and transaction behavior require runtime checks.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/uuid"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "status": {
      "enum": [
        "ENABLED",
        "DISABLED",
        "EXPIRED",
        "EXHAUSTED",
        "RECONFIRM_REQUIRED"
      ]
    },
    "definition": {
      "$ref": "#/$defs/definition"
    },
    "destination": {
      "const": "OWN_INBOX"
    },
    "next_occurrence": {
      "anyOf": [
        {
          "$ref": "#/$defs/preview"
        },
        {
          "type": "null"
        }
      ]
    },
    "delivered_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31
    },
    "created_at": {
      "$ref": "#/$defs/utc"
    },
    "updated_at": {
      "$ref": "#/$defs/utc"
    }
  },
  "required": [
    "id",
    "version",
    "status",
    "definition",
    "destination",
    "next_occurrence",
    "delivered_count",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "ENABLED"
            }
          }
        }
      },
      "then": {
        "properties": {
          "next_occurrence": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "definition": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/$defs/title"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "recurrence": {
          "enum": [
            "ONCE",
            "DAILY",
            "WEEKDAYS",
            "WEEKLY",
            "CUSTOM_DAYS"
          ]
        },
        "start_date": {
          "$ref": "#/$defs/date"
        },
        "local_time": {
          "$ref": "#/$defs/time"
        },
        "timezone": {
          "$ref": "#/$defs/timezone"
        },
        "weekdays": {
          "type": "array",
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        },
        "authorization_expires_at": {
          "$ref": "#/$defs/utc"
        },
        "max_deliveries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      },
      "required": [
        "title",
        "text",
        "project_id",
        "recurrence",
        "start_date",
        "local_time",
        "timezone",
        "weekdays",
        "authorization_expires_at",
        "max_deliveries"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "recurrence": {
                "enum": [
                  "ONCE",
                  "DAILY",
                  "WEEKDAYS"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "weekdays": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recurrence": {
                "const": "ONCE"
              }
            }
          },
          "then": {
            "properties": {
              "max_deliveries": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recurrence": {
                "const": "WEEKLY"
              }
            }
          },
          "then": {
            "properties": {
              "weekdays": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recurrence": {
                "const": "CUSTOM_DAYS"
              }
            }
          },
          "then": {
            "properties": {
              "weekdays": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]",
      "not": {
        "pattern": "[\\u0000-\\u001F\\u007F-\\u009F\\uD800-\\uDFFF]"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]",
      "not": {
        "pattern": "[\\u0000-\\u001F\\u007F-\\u009F\\uD800-\\uDFFF]"
      }
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"
    },
    "time": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$(?![\\s\\S])"
    },
    "timezone": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^(?:UTC|(?!SystemV/)[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)+)$(?![\\s\\S])"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]{1,6})?Z$(?![\\s\\S])"
    },
    "preview": {
      "type": "object",
      "properties": {
        "planned_fire_at_utc": {
          "$ref": "#/$defs/utc"
        },
        "local_datetime": {
          "$ref": "#/$defs/local"
        },
        "offset_seconds": {
          "type": "integer",
          "minimum": -64800,
          "maximum": 64800
        },
        "dst_adjustment": {
          "enum": [
            "NONE",
            "GAP_FORWARD",
            "FOLD_FIRST"
          ]
        }
      },
      "required": [
        "planned_fire_at_utc",
        "local_datetime",
        "offset_seconds",
        "dst_adjustment"
      ],
      "additionalProperties": false
    },
    "local": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$(?![\\s\\S])"
    }
  }
}
