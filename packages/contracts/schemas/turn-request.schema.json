{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/turn-request.schema.json",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_input": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "current_time": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "project_context": {
      "type": "null"
    },
    "memories": {
      "type": "array",
      "maxItems": 0
    },
    "evidence": {
      "type": "array",
      "maxItems": 0
    },
    "tool_results": {
      "type": "array",
      "maxItems": 0
    },
    "allowed_tool_ids": {
      "type": "array",
      "items": {
        "const": "calendar.event.create"
      },
      "maxItems": 1
    },
    "budget": {
      "type": "object",
      "properties": {
        "reservation_id": {
          "type": "string",
          "format": "uuid"
        },
        "max_compute_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "max_model_calls": {
          "const": 1
        }
      },
      "required": [
        "reservation_id",
        "max_compute_ms",
        "max_input_tokens",
        "max_output_tokens",
        "max_model_calls"
      ],
      "additionalProperties": false
    },
    "model_id": {
      "enum": [
        "mock-v1",
        "local-mlx-v1"
      ]
    },
    "model_manifest_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prompt_revision": {
      "enum": [
        "mock-v1",
        "local-v1"
      ]
    }
  },
  "required": [
    "request_id",
    "run_id",
    "user_input",
    "current_time",
    "timezone",
    "project_context",
    "memories",
    "evidence",
    "tool_results",
    "allowed_tool_ids",
    "budget",
    "model_id",
    "model_manifest_hash",
    "prompt_revision"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "model_id": {
            "const": "local-mlx-v1"
          }
        }
      },
      "then": {
        "properties": {
          "prompt_revision": {
            "const": "local-v1"
          }
        }
      },
      "else": {
        "properties": {
          "prompt_revision": {
            "const": "mock-v1"
          }
        }
      }
    }
  ]
}
