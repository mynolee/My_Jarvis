{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/turn-request.schema.json",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_input": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "current_time": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "project_context": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        }
      ]
    },
    "memories": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "scope": {
            "enum": [
              "GLOBAL",
              "PROJECT"
            ]
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "enum": [
              "PROFILE",
              "PREFERENCE"
            ]
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$(?![\\s\\S])"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "not": {
              "pattern": "[\\u0000\\uD800-\\uDFFF]"
            },
            "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]",
            "description": "Exact Unicode scalar text, nonblank, no NUL. Runtime UTF-8 bound: 8000 bytes. No normalization."
          },
          "confirmed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])",
            "description": "Server UTC timestamp; valid calendar date, years 0001..9999, at most six fractional digits."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])",
            "description": "Server UTC timestamp; valid calendar date, years 0001..9999, at most six fractional digits."
          }
        },
        "required": [
          "source_id",
          "id",
          "version",
          "generation",
          "scope",
          "project_id",
          "kind",
          "key",
          "value",
          "confirmed_at",
          "updated_at"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "scope": {
                  "const": "GLOBAL"
                }
              }
            },
            "then": {
              "properties": {
                "project_id": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "project_id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
                }
              }
            }
          }
        ]
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 0
    },
    "tool_results": {
      "type": "array",
      "maxItems": 0
    },
    "allowed_tool_ids": {
      "type": "array",
      "items": {
        "const": "calendar.event.create"
      },
      "maxItems": 1
    },
    "budget": {
      "type": "object",
      "properties": {
        "reservation_id": {
          "type": "string",
          "format": "uuid"
        },
        "max_compute_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "max_model_calls": {
          "const": 1
        }
      },
      "required": [
        "reservation_id",
        "max_compute_ms",
        "max_input_tokens",
        "max_output_tokens",
        "max_model_calls"
      ],
      "additionalProperties": false
    },
    "model_id": {
      "enum": [
        "mock-v1",
        "local-mlx-v1"
      ]
    },
    "model_manifest_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prompt_revision": {
      "enum": [
        "mock-v1",
        "local-v1"
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "revision": {
          "const": 1
        },
        "conversation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "context_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "history_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "profile_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "conversation_id",
        "context_epoch",
        "history_epoch",
        "profile_version"
      ],
      "additionalProperties": false
    },
    "history": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/contextHistoryMessage"
      },
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/contextHistoryMessage"
            },
            {
              "properties": {
                "role": {
                  "const": "USER"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/contextHistoryMessage"
            },
            {
              "properties": {
                "role": {
                  "const": "ASSISTANT"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/contextHistoryMessage"
            },
            {
              "properties": {
                "role": {
                  "const": "USER"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/contextHistoryMessage"
            },
            {
              "properties": {
                "role": {
                  "const": "ASSISTANT"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/contextHistoryMessage"
            },
            {
              "properties": {
                "role": {
                  "const": "USER"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/contextHistoryMessage"
            },
            {
              "properties": {
                "role": {
                  "const": "ASSISTANT"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/contextHistoryMessage"
            },
            {
              "properties": {
                "role": {
                  "const": "USER"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/contextHistoryMessage"
            },
            {
              "properties": {
                "role": {
                  "const": "ASSISTANT"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/contextHistoryMessage"
            },
            {
              "properties": {
                "role": {
                  "const": "USER"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/contextHistoryMessage"
            },
            {
              "properties": {
                "role": {
                  "const": "ASSISTANT"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/contextHistoryMessage"
            },
            {
              "properties": {
                "role": {
                  "const": "USER"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/contextHistoryMessage"
            },
            {
              "properties": {
                "role": {
                  "const": "ASSISTANT"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/contextHistoryMessage"
            },
            {
              "properties": {
                "role": {
                  "const": "USER"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/contextHistoryMessage"
            },
            {
              "properties": {
                "role": {
                  "const": "ASSISTANT"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/contextHistoryMessage"
            },
            {
              "properties": {
                "role": {
                  "const": "USER"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/contextHistoryMessage"
            },
            {
              "properties": {
                "role": {
                  "const": "ASSISTANT"
                }
              }
            }
          ]
        }
      ],
      "allOf": [
        {
          "not": {
            "minItems": 1,
            "maxItems": 1
          }
        },
        {
          "not": {
            "minItems": 3,
            "maxItems": 3
          }
        },
        {
          "not": {
            "minItems": 5,
            "maxItems": 5
          }
        },
        {
          "not": {
            "minItems": 7,
            "maxItems": 7
          }
        },
        {
          "not": {
            "minItems": 9,
            "maxItems": 9
          }
        },
        {
          "not": {
            "minItems": 11,
            "maxItems": 11
          }
        },
        {
          "not": {
            "minItems": 13,
            "maxItems": 13
          }
        },
        {
          "not": {
            "minItems": 15,
            "maxItems": 15
          }
        }
      ]
    }
  },
  "required": [
    "request_id",
    "run_id",
    "user_input",
    "current_time",
    "timezone",
    "project_context",
    "memories",
    "evidence",
    "tool_results",
    "allowed_tool_ids",
    "budget",
    "model_id",
    "model_manifest_hash",
    "prompt_revision"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "model_id": {
            "const": "local-mlx-v1"
          }
        }
      },
      "then": {
        "properties": {
          "prompt_revision": {
            "const": "local-v1"
          }
        }
      },
      "else": {
        "properties": {
          "prompt_revision": {
            "const": "mock-v1"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "context"
        ]
      },
      "then": {
        "required": [
          "history"
        ],
        "properties": {
          "model_id": {
            "const": "local-mlx-v1"
          },
          "prompt_revision": {
            "const": "local-v1"
          },
          "allowed_tool_ids": {
            "maxItems": 0
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
          },
          "run_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
          },
          "current_time": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])",
            "description": "Server UTC timestamp; valid calendar date, years 0001..9999, at most six fractional digits."
          },
          "user_input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000,
            "not": {
              "pattern": "[\\u0000\\uD800-\\uDFFF]"
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "history"
          ]
        },
        "properties": {
          "project_context": {
            "type": "null"
          },
          "memories": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$comment": "Context-v1 is opt-in via required context.revision=1 and history. Omission preserves legacy request behavior. Canonical transport cap 262144 bytes includes context. Wire validation does not prove authorization or exact native token admission.",
  "$defs": {
    "contextHistoryMessage": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "run_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "role": {
          "enum": [
            "USER",
            "ASSISTANT"
          ]
        },
        "trust": {
          "enum": [
            "USER_DIRECT",
            "MODEL_PROPOSAL"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000,
          "not": {
            "pattern": "[\\u0000\\uD800-\\uDFFF]"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])",
          "description": "Server UTC timestamp; valid calendar date, years 0001..9999, at most six fractional digits."
        }
      },
      "required": [
        "source_id",
        "id",
        "run_id",
        "role",
        "trust",
        "text",
        "created_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "USER"
              }
            }
          },
          "then": {
            "properties": {
              "trust": {
                "const": "USER_DIRECT"
              }
            }
          },
          "else": {
            "properties": {
              "trust": {
                "const": "MODEL_PROPOSAL"
              }
            }
          }
        }
      ]
    }
  }
}
