{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/memory-list-query.schema.json",
  "$comment": "Wire-shape validation only. Ownership, recent database reauthentication, server session/epoch, payload binding, single-use approval, expiry and transaction atomicity require server enforcement. Parse with strict integer-only JSON and cap canonical request bodies at 16384 bytes before accepting.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "scope": {
          "const": "GLOBAL"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "not": {
            "pattern": "[\\u0000\\uD800-\\uDFFF]"
          },
          "description": "Opaque signed cursor. Runtime verifies owner and query binding; length is an implementation limit."
        }
      },
      "required": [
        "scope"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "scope": {
          "const": "PROJECT"
        },
        "project_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "not": {
            "pattern": "[\\u0000\\uD800-\\uDFFF]"
          },
          "description": "Opaque signed cursor. Runtime verifies owner and query binding; length is an implementation limit."
        }
      },
      "required": [
        "scope",
        "project_id"
      ],
      "additionalProperties": false
    }
  ]
}
