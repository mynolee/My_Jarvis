{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/owner-profile-patch-result.schema.json",
  "$comment": "Wire shape only. Server must enforce authenticated owner/live session and epoch, Origin/CSRF, exact Java TZDB membership, strict integer-only JSON, duplicate-key/header/query rejection, canonical request cap 4096 bytes, transactional versioning and session-bound HMAC idempotency. No scheduling, translation or inference personalization is enabled.",
  "type": "object",
  "properties": {
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "login_name": {
          "type": "string"
        },
        "execution_paused": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "mode": {
          "const": "MOCK"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "not": {
                "pattern": "[\\u0000-\\u001F\\u007F-\\u009F\\uD800-\\uDFFF]"
              },
              "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]",
              "description": "Exact unnormalized Unicode scalar text; 1..80 codepoints, at most 320 UTF-8 bytes; no ISO controls, not entirely Unicode White_Space plus FEFF. Null explicitly clears."
            }
          ]
        },
        "locale": {
          "enum": [
            "ko-KR",
            "en-US"
          ]
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?:UTC|(?!SystemV/)[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)+)$(?![\\s\\S])",
          "description": "ASCII lexical candidate only. Exact case-sensitive membership in server startup set is mandatory: UTC plus Java ZoneId available IDs containing / except SystemV/. Preserve aliases exactly. Neither regex nor ZoneId.of alone proves support."
        },
        "profile_updated_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])",
              "description": "Database-clock UTC instant with at most microsecond precision; valid calendar date/year 0001..9999 required."
            },
            {
              "type": "null"
            }
          ]
        },
        "server_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])",
          "description": "Database-clock UTC instant with at most microsecond precision; valid calendar date/year 0001..9999 required."
        },
        "profile_effects": {
          "type": "object",
          "properties": {
            "settings_time_preview": {
              "const": true
            },
            "ui_translation": {
              "const": false
            },
            "chat_personalization": {
              "const": false
            },
            "inference_timezone": {
              "const": "UTC"
            },
            "scheduling": {
              "const": false
            }
          },
          "required": [
            "settings_time_preview",
            "ui_translation",
            "chat_personalization",
            "inference_timezone",
            "scheduling"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "login_name",
        "execution_paused",
        "version",
        "mode",
        "display_name",
        "locale",
        "timezone",
        "profile_updated_at",
        "server_time",
        "profile_effects"
      ],
      "additionalProperties": false
    },
    "mutation": {
      "type": "object",
      "properties": {
        "status": {
          "const": "COMMITTED"
        },
        "owner_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "updated_fields": {
          "enum": [
            [
              "display_name"
            ],
            [
              "locale"
            ],
            [
              "timezone"
            ],
            [
              "display_name",
              "locale"
            ],
            [
              "display_name",
              "timezone"
            ],
            [
              "locale",
              "timezone"
            ],
            [
              "display_name",
              "locale",
              "timezone"
            ]
          ],
          "description": "Nonempty submitted field names, unique and lexicographically sorted; never values."
        }
      },
      "required": [
        "status",
        "owner_id",
        "version",
        "updated_fields"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "profile",
    "mutation"
  ],
  "additionalProperties": false
}
