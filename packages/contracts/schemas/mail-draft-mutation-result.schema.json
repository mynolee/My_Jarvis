{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/mail-draft-mutation-result.schema.json",
  "$comment": "Synthetic wire shape only. Strict integer JSON, duplicate-key rejection, combined recipient count, UTF-8/canonical byte limits, cross-field relations and authorization require runtime enforcement. No external sending or verified attachment capability.",
  "type": "object",
  "properties": {
    "draft": {
      "type": "object",
      "properties": {
        "sender_candidate": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 320,
              "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]",
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 320,
            "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]",
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]"
            }
          }
        },
        "cc": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 320,
            "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]",
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]"
            }
          }
        },
        "bcc": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 320,
            "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]",
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]"
            }
          }
        },
        "subject": {
          "type": "string",
          "maxLength": 200,
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]"
          }
        },
        "body": {
          "type": "string",
          "maxLength": 16000,
          "not": {
            "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\ud800-\\udfff]"
          }
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "attachments": {
          "type": "array",
          "maxItems": 0
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])"
        },
        "delivery_status": {
          "const": "NOT_SENT"
        }
      },
      "required": [
        "sender_candidate",
        "to",
        "cc",
        "bcc",
        "subject",
        "body",
        "project_id",
        "attachments",
        "id",
        "version",
        "created_at",
        "updated_at",
        "delivery_status"
      ],
      "additionalProperties": false
    },
    "mutation": {
      "type": "object",
      "properties": {
        "status": {
          "const": "COMMITTED"
        },
        "draft_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "operation": {
          "enum": [
            "CREATE",
            "UPDATE"
          ]
        }
      },
      "required": [
        "status",
        "draft_id",
        "version",
        "operation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "draft",
    "mutation"
  ],
  "additionalProperties": false
}
