{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/mail-draft-list-query.schema.json",
  "$comment": "Synthetic wire shape only. Strict integer JSON, duplicate-key rejection, combined recipient count, UTF-8/canonical byte limits, cross-field relations and authorization require runtime enforcement. No external sending or verified attachment capability.",
  "type": "object",
  "properties": {
    "limit": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]?|100)$(?![\\s\\S])"
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_.-]+$(?![\\s\\S])"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
    }
  },
  "required": [],
  "additionalProperties": false
}
