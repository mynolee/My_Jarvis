{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/today-response.schema.json",
  "type": "object",
  "properties": {
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "local_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "day_start_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "next_day_start_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "deadline_window_end_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "tasks": {
      "type": "object",
      "properties": {
        "status": {
          "const": "AVAILABLE"
        },
        "top_tasks": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "project_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "not": {
                  "pattern": "\u0000"
                }
              },
              "priority": {
                "enum": [
                  "HIGH",
                  "NORMAL",
                  "LOW"
                ]
              },
              "status": {
                "enum": [
                  "TODO",
                  "IN_PROGRESS"
                ]
              },
              "due_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "project_id",
              "title",
              "priority",
              "status",
              "due_at",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "deadlines": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "project_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "not": {
                  "pattern": "\u0000"
                }
              },
              "priority": {
                "enum": [
                  "HIGH",
                  "NORMAL",
                  "LOW"
                ]
              },
              "status": {
                "enum": [
                  "TODO",
                  "IN_PROGRESS"
                ]
              },
              "due_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "project_id",
              "title",
              "priority",
              "status",
              "due_at",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "deadline_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deadlines_truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "top_tasks",
        "deadlines",
        "deadline_total",
        "deadlines_truncated"
      ],
      "additionalProperties": false
    },
    "calendar": {
      "type": "object",
      "properties": {
        "status": {
          "const": "UNAVAILABLE"
        },
        "reason": {
          "const": "NOT_IMPLEMENTED"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "briefing": {
      "type": "object",
      "properties": {
        "status": {
          "const": "UNAVAILABLE"
        },
        "reason": {
          "const": "NOT_IMPLEMENTED"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "properties": {
        "status": {
          "const": "UNAVAILABLE"
        },
        "reason": {
          "const": "NOT_IMPLEMENTED"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "checked_at",
    "timezone",
    "local_date",
    "day_start_at",
    "next_day_start_at",
    "deadline_window_end_at",
    "tasks",
    "calendar",
    "briefing",
    "device"
  ],
  "additionalProperties": false
}
