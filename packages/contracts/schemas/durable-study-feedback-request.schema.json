{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/durable-study-feedback-request.schema.json",
  "type": "object",
  "properties": {
    "expected_study_version": {
      "const": 3
    },
    "expected_conversation_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "question_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "input_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
    }
  },
  "required": [
    "expected_study_version",
    "expected_conversation_version",
    "question_id",
    "input_id",
    "attempt_id"
  ],
  "additionalProperties": false
}
