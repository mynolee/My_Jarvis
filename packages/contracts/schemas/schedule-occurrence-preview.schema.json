{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/schedule-occurrence-preview.schema.json",
  "$comment": "Synthetic wire shape only. Strict integer-only JSON, actual dates, exact server timezone membership, sibling consistency, authority, DB clock, storage privacy and transaction behavior require runtime checks.",
  "type": "object",
  "properties": {
    "planned_fire_at_utc": {
      "$ref": "#/$defs/utc"
    },
    "local_datetime": {
      "$ref": "#/$defs/local"
    },
    "offset_seconds": {
      "type": "integer",
      "minimum": -64800,
      "maximum": 64800
    },
    "dst_adjustment": {
      "enum": [
        "NONE",
        "GAP_FORWARD",
        "FOLD_FIRST"
      ]
    }
  },
  "required": [
    "planned_fire_at_utc",
    "local_datetime",
    "offset_seconds",
    "dst_adjustment"
  ],
  "additionalProperties": false,
  "$defs": {
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]{1,6})?Z$(?![\\s\\S])"
    },
    "local": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$(?![\\s\\S])"
    }
  }
}
