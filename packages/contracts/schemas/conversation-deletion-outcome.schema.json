{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/conversation-deletion-outcome.schema.json",
  "$comment": "Closed wire shape only. Strict UTF-8/integer-only JSON parsing and real calendar format assertions are required. Runtime enforces cross-field relationships, current owner/session/epoch, exact reviewed snapshot, quiescence, provenance, transaction limits and tombstone barriers.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "const": "COMMITTED"
        },
        "receipt": {
          "type": "object",
          "properties": {
            "deletion_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
            },
            "conversation_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
            },
            "preparation_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
            },
            "scope_policy": {
              "const": "CONVERSATION_SOURCE_V1"
            },
            "deleted_version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740990
            },
            "tombstone_version": {
              "type": "integer",
              "minimum": 2,
              "maximum": 9007199254740991
            },
            "deleted_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])"
            }
          },
          "required": [
            "deletion_id",
            "conversation_id",
            "preparation_id",
            "scope_policy",
            "deleted_version",
            "tombstone_version",
            "deleted_at"
          ],
          "additionalProperties": false
        },
        "checked_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])"
        }
      },
      "required": [
        "status",
        "receipt",
        "checked_at"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "const": "NOT_OBSERVED"
        },
        "receipt": {
          "type": "null"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])"
        }
      },
      "required": [
        "status",
        "receipt",
        "checked_at"
      ],
      "additionalProperties": false
    }
  ]
}
