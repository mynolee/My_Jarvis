{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/memory-intent-response.schema.json",
  "$comment": "Wire-shape validation only. Ownership, recent database reauthentication, server session/epoch, payload binding, single-use approval, expiry and transaction atomicity require server enforcement. Parse with strict integer-only JSON and cap canonical request bodies at 16384 bytes before accepting.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "tool_id": {
      "const": "memory.write"
    },
    "operation": {
      "enum": [
        "CREATE",
        "REVISE"
      ]
    },
    "target_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "expected_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])",
      "description": "Server UTC timestamp; valid calendar date, years 0001..9999, at most six fractional digits."
    },
    "status": {
      "const": "ISSUED"
    }
  },
  "required": [
    "id",
    "tool_id",
    "operation",
    "target_id",
    "expected_generation",
    "payload_hash",
    "expires_at",
    "status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "REVISE"
          }
        }
      },
      "then": {
        "properties": {
          "expected_generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    }
  ]
}
