{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/usage-response.schema.json",
  "$comment": "Summary-only data payload. Owner/live-session authorization, one database snapshot, calendar-zone correctness, complete nonoverlapping classification, attribution, idempotent bound measurement evidence, checked arithmetic, peak MAX and unchanged UTC quotas require semantic/runtime validation.",
  "type": "object",
  "properties": {
    "checked_at": {
      "$ref": "#/$defs/timestamp"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(?:UTC|(?!SystemV/)[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)+)$(?![\\s\\S])",
      "description": "Exact saved owner timezone. Server supported-TZDB membership is required; this regex is only a lexical check."
    },
    "attribution": {
      "const": "RESERVATION_CREATED_AT"
    },
    "quota_timezone": {
      "const": "UTC"
    },
    "day": {
      "$ref": "#/$defs/period"
    },
    "month": {
      "$ref": "#/$defs/period"
    }
  },
  "required": [
    "checked_at",
    "timezone",
    "attribution",
    "quota_timezone",
    "day",
    "month"
  ],
  "additionalProperties": false,
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])"
    },
    "counts": {
      "type": "object",
      "properties": {
        "measured": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pending": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "in_progress": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unstarted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uncertain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "legacy_unavailable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "measured",
        "pending",
        "in_progress",
        "unstarted",
        "uncertain",
        "legacy_unavailable"
      ],
      "additionalProperties": false
    },
    "measured": {
      "type": "object",
      "properties": {
        "request_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "compute_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "peak_memory_bytes": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "external_cost_usd_micro": {
          "type": "null",
          "description": "No external monetary-cost source is implemented. Unknown cost remains null, including an empty period."
        }
      },
      "required": [
        "request_count",
        "input_tokens",
        "output_tokens",
        "compute_ms",
        "peak_memory_bytes",
        "external_cost_usd_micro"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "request_count": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "input_tokens": {
                "const": 0
              },
              "output_tokens": {
                "const": 0
              },
              "compute_ms": {
                "const": 0
              },
              "peak_memory_bytes": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "peak_memory_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        }
      ]
    },
    "conservative_reserved": {
      "type": "object",
      "properties": {
        "request_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_compute_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "request_count",
        "max_compute_ms",
        "max_output_tokens"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "request_count": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "max_compute_ms": {
                "const": 0
              },
              "max_output_tokens": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "period": {
      "type": "object",
      "properties": {
        "local_key": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}(?:-[0-9]{2})?$(?![\\s\\S])"
        },
        "start_at": {
          "$ref": "#/$defs/timestamp"
        },
        "end_at": {
          "$ref": "#/$defs/timestamp"
        },
        "request_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "measured": {
          "$ref": "#/$defs/measured"
        },
        "conservative_reserved": {
          "$ref": "#/$defs/conservative_reserved"
        }
      },
      "required": [
        "local_key",
        "start_at",
        "end_at",
        "request_count",
        "counts",
        "measured",
        "conservative_reserved"
      ],
      "additionalProperties": false
    }
  }
}
