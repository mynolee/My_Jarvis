      "then": {
        "properties": {
          "resource_kind": {
            "const": "RUN"
          },
          "resource_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "OTHER"
          }
        }
      },
      "then": {
        "properties": {
          "resource_kind": {
            "const": "OTHER"
          },
          "resource_id": {
            "type": "null"
          },
          "run": {
            "type": "null"
          }
