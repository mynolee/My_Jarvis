          "resource_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
          },
          "run": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "REMINDER_INBOX_CREATED",
              "NOTIFICATION_OPENED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "resource_kind": {
            "const": "NOTIFICATION"
          },
          "resource_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
          },
          "run": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "RUN_ACCEPTED",
              "RUN_CANCELLED",
              "RUN_WAITING_INPUT",
              "RUN_SUCCEEDED",
              "RUN_WAITING_APPROVAL",
              "RUN_BLOCKED",
              "RUN_UNKNOWN",
              "WORKER_UNCERTAIN_OR_FAILED",
              "MOCK_EXECUTION_STARTED",
              "LEASE_EXPIRED_UNKNOWN",
              "MOCK_RECONCILED",
              "APPROVAL_REJECTED",
              "APPROVAL_CONSUMED",
              "CANCEL_REQUESTED",
              "LOCAL_INFERENCE_RESERVED",
              "LOCAL_INFERENCE_STARTED",
              "LOCAL_INFERENCE_UNKNOWN",
              "LOCAL_INFERENCE_SUCCEEDED",
              "LOCAL_INFERENCE_WAITING_INPUT",
              "LOCAL_INFERENCE_FAILED",
