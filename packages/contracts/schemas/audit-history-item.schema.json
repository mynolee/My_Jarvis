          "resource_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
          },
          "run": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "REMINDER_PLANNED",
              "REMINDER_BLOCKED",
              "REMINDER_SKIPPED_MISSED",
              "REMINDER_CANCELLED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "resource_kind": {
            "const": "SCHEDULE_OCCURRENCE"
