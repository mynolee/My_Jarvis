{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/memory-revisions.schema.json",
  "$comment": "Wire-shape validation only. Ownership, recent database reauthentication, server session/epoch, payload binding, single-use approval, expiry and transaction atomicity require server enforcement. Parse with strict integer-only JSON and cap canonical request bodies at 16384 bytes before accepting.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "memory_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "not": {
              "pattern": "[\\u0000\\uD800-\\uDFFF]"
            },
            "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]",
            "description": "Exact Unicode scalar text, nonblank, no NUL. Runtime UTF-8 bound: 8000 bytes. No normalization."
          },
          "change_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "not": {
              "pattern": "[\\u0000\\uD800-\\uDFFF]"
            },
            "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]",
            "description": "Exact Unicode scalar text, nonblank, no NUL. Runtime UTF-8 bound: 1200 bytes. No normalization."
          },
          "source": {
            "type": "object",
            "properties": {
              "type": {
                "const": "EXPLICIT_OWNER_FORM"
              },
              "submission_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
              },
              "submitted_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])",
                "description": "Server UTC timestamp; valid calendar date, years 0001..9999, at most six fractional digits."
              },
              "source_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              }
            },
            "required": [
              "type",
              "submission_id",
              "submitted_at",
              "source_hash"
            ],
            "additionalProperties": false
          },
          "confirmed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])",
            "description": "Server UTC timestamp; valid calendar date, years 0001..9999, at most six fractional digits."
          }
        },
        "required": [
          "memory_id",
          "version",
          "value",
          "change_reason",
          "source",
          "confirmed_at"
        ],
        "additionalProperties": false
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "not": {
            "pattern": "[\\u0000\\uD800-\\uDFFF]"
          },
          "description": "Opaque signed cursor. Runtime verifies owner and query binding; length is an implementation limit."
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "items",
    "next_cursor"
  ],
  "additionalProperties": false
}
