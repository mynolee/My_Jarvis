{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/approval-decision.schema.json",
  "type": "object",
  "properties": {
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT"
      ]
    },
    "expected_action_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "decision",
    "expected_action_version",
    "payload_hash"
  ],
  "additionalProperties": false
}
