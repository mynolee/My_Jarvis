{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/memory-create-request.schema.json",
  "$comment": "Wire-shape validation only. Ownership, recent database reauthentication, server session/epoch, payload binding, single-use approval, expiry and transaction atomicity require server enforcement. Parse with strict integer-only JSON and cap canonical request bodies at 16384 bytes before accepting.",
  "type": "object",
  "properties": {
    "intent_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "arguments": {
      "type": "object",
      "properties": {
        "scope": {
          "enum": [
            "GLOBAL",
            "PROJECT"
          ]
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,95}$(?![\\s\\S])"
        },
        "kind": {
          "enum": [
            "PROFILE",
            "PREFERENCE"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "not": {
            "pattern": "[\\u0000\\uD800-\\uDFFF]"
          },
          "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]",
          "description": "Exact Unicode scalar text, nonblank, no NUL. Runtime UTF-8 bound: 8000 bytes. No normalization."
        },
        "change_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "not": {
            "pattern": "[\\u0000\\uD800-\\uDFFF]"
          },
          "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]",
          "description": "Exact Unicode scalar text, nonblank, no NUL. Runtime UTF-8 bound: 1200 bytes. No normalization."
        },
        "expected_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "revive_deleted": {
          "type": "boolean"
        }
      },
      "required": [
        "scope",
        "project_id",
        "key",
        "kind",
        "value",
        "change_reason",
        "expected_generation",
        "revive_deleted"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "GLOBAL"
              }
            }
          },
          "then": {
            "properties": {
              "project_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "project_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "intent_id",
    "arguments"
  ],
  "additionalProperties": false
}
