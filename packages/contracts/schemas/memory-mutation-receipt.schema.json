{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/memory-mutation-receipt.schema.json",
  "$comment": "Wire-shape validation only. Ownership, recent database reauthentication, server session/epoch, payload binding, single-use approval, expiry and transaction atomicity require server enforcement. Parse with strict integer-only JSON and cap canonical request bodies at 16384 bytes before accepting.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "const": "NOT_OBSERVED"
        },
        "memory_id": {
          "type": "null"
        },
        "version": {
          "type": "null"
        },
        "generation": {
          "type": "null"
        },
        "operation": {
          "type": "null"
        }
      },
      "required": [
        "status",
        "memory_id",
        "version",
        "generation",
        "operation"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "const": "COMMITTED"
        },
        "memory_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "operation": {
          "enum": [
            "CREATE",
            "REVISE"
          ]
        }
      },
      "required": [
        "status",
        "memory_id",
        "version",
        "generation",
        "operation"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "const": "REDACTED_DELETED"
        },
        "memory_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "operation": {
          "enum": [
            "CREATE",
            "REVISE",
            "DELETE"
          ]
        }
      },
      "required": [
        "status",
        "memory_id",
        "version",
        "generation",
        "operation"
      ],
      "additionalProperties": false
    }
  ]
}
