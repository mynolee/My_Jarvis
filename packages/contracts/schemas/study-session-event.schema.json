{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myjarvis:study-session-event:v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ANSWER"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "question_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "allOf": [
            {
              "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
            },
            {
              "not": {
                "pattern": "[\\u0000\\uD800-\\uDFFF]"
              }
            }
          ]
        }
      },
      "required": [
        "kind",
        "session_id",
        "expected_version",
        "question_id",
        "attempt_id",
        "answer"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "FEEDBACK"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "feedback": {
          "$ref": "urn:myjarvis:study-session:v1#/$defs/feedback"
        }
      },
      "required": [
        "kind",
        "session_id",
        "expected_version",
        "feedback"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "CLOSE"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "session_id",
        "expected_version"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "SOURCE_UNAVAILABLE"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "session_id",
        "expected_version"
      ]
    }
  ]
}
