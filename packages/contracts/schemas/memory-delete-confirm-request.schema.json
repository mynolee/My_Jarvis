{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/memory-delete-confirm-request.schema.json",
  "$comment": "Wire-shape validation only. Ownership, recent database reauthentication, server session/epoch, payload binding, single-use approval, expiry and transaction atomicity require server enforcement. Parse with strict integer-only JSON and cap canonical request bodies at 16384 bytes before accepting.",
  "type": "object",
  "properties": {
    "payload_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expected_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "confirm": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "payload_hash",
    "expected_version",
    "expected_generation",
    "confirm"
  ],
  "additionalProperties": false
}
