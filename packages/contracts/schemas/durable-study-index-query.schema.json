{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-jarvis.invalid/contracts/durable-study-index-query.schema.json",
  "$comment": "Closed wire shape. Integer-only canonical JSON, byte ceilings and cross-field identity, version and time relationships are additionally checked by the service and contract oracle.",
  "type": "object",
  "properties": {
    "limit": {
      "type": "string",
      "pattern": "^(?:[1-9]|[1-4][0-9]|50)$(?![\\s\\S])"
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_-]+\\.[0-9a-f]{64}$(?![\\s\\S])"
    }
  },
  "required": [],
  "additionalProperties": false
}
